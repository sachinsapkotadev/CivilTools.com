{
  "name": "civil-tools",
  "type": "module",
  "version": "1.0.0",
  "private": false,
  "description": "Modern Civil Engineering Tools built with Astro, TypeScript and Tailwind CSS. Fast, SEO-friendly, responsive calculators and utilities for civil engineers, architects, contractors and quantity surveyors.",
  "author": "Sachin Sapkota <sachin.sapkota.dev@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.civiltools.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/civil-tools"
  },
  "bugs": {
    "url": "https://github.com/yourusername/civil-tools/issues"
  },
  "keywords": [
    "civil-engineering",
    "construction-calculators",
    "astro",
    "typescript",
    "tailwindcss",
    "engineering-tools",
    "cloudflare-workers",
    "concrete-calculator",
    "steel-weight-calculator",
    "building-cost-estimator",
    "nepal-land-converter",
    "seo"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "deploy": "astro build && wrangler deploy",
    "astro": "astro",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "sync-sitemap": "node scripts/sync-sitemap.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^14.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.1",
    "firebase": "^12.16.0",
    "stripe": "^22.3.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.112.0"
  }
}
