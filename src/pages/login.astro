---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="auth-page">
    <div class="auth-card">
      <p class="auth-heading">Welcome back</p>
      <p class="auth-subtitle">Sign in to your account</p>

      <form id="login-form" class="auth-form">
        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="you@example.com" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="password">Password</label>
          <input type="password" id="password" name="password" placeholder="Enter your password" required autocomplete="current-password" />
        </div>
        <button type="submit" class="btn-primary btn-full" id="login-btn">Sign in</button>
        <p id="auth-error" class="auth-error"></p>
      </form>

      <div class="auth-divider"><span>or</span></div>

      <div class="social-login">
        <button id="google-btn" class="btn-social">
          <svg width="18" height="18" viewBox="0 0 24 24"><path fill="#4285F4" d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 0 1-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z"/><path fill="#34A853" d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/><path fill="#FBBC05" d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/><path fill="#EA4335" d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/></svg>
          Google
        </button>

      </div>

      <div class="auth-footer">
        <a href="/forgot-password" class="auth-text-link">Forgot password?</a>
        <a href="/signup" class="btn-outline btn-full">Create account</a>
      </div>
    </div>
  </section>
</Layout>

<script>
import { auth } from '../lib/firebase';
import { signInWithEmailAndPassword, signInWithPopup, GoogleAuthProvider } from 'firebase/auth';

const form = document.getElementById('login-form');
const errorEl = document.getElementById('auth-error');
const loginBtn = document.getElementById('login-btn');

form.addEventListener('submit', async (e) => {
  e.preventDefault();
  errorEl.textContent = '';
  errorEl.classList.remove('visible');
  loginBtn.disabled = true;
  loginBtn.textContent = 'Signing in...';
  const email = document.getElementById('email').value;
  const password = document.getElementById('password').value;

  try {
    await signInWithEmailAndPassword(auth, email, password);
    window.location.href = '/dashboard';
  } catch (err) {
    loginBtn.disabled = false;
    loginBtn.textContent = 'Sign in';
    const messages = {
      'auth/user-not-found': 'No account found with this email.',
      'auth/wrong-password': 'Incorrect password.',
      'auth/invalid-credential': 'Invalid email or password.',
      'auth/invalid-email': 'Please enter a valid email address.',
      'auth/user-disabled': 'This account has been disabled.',
    };
    errorEl.textContent = messages[err.code] || err.message;
    errorEl.classList.add('visible');
  }
});

async function socialSignIn(provider) {
  errorEl.textContent = '';
  errorEl.classList.remove('visible');
  try {
    await signInWithPopup(auth, provider);
    window.location.href = '/dashboard';
  } catch (err) {
    if (err.code === 'auth/popup-closed-by-user') return;
    const messages = {
      'auth/account-exists-with-different-credential': 'An account already exists with the same email using a different sign-in method.',
      'auth/popup-blocked': 'Popup was blocked by your browser. Please allow popups.',
    };
    errorEl.textContent = messages[err.code] || err.message;
    errorEl.classList.add('visible');
  }
}

document.getElementById('google-btn').addEventListener('click', () => socialSignIn(new GoogleAuthProvider()));
</script>

<style is:global>
  .auth-page {
    min-height: calc(100vh - 64px);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 48px 24px;
  }

  .auth-card {
    width: 100%;
    max-width: 400px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 40px 32px;
  }

  .auth-heading {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.5px;
    margin: 0 0 4px;
    color: var(--text-primary);
    text-align: center;
  }

  .auth-subtitle {
    font-size: 14px;
    color: var(--text-tertiary);
    margin: 0 0 28px;
    text-align: center;
  }

  .auth-form {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .form-group label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
  }

  .form-group input {
    height: 40px;
    padding: 0 12px;
    border: 1px solid var(--border-input);
    border-radius: 6px;
    font-size: 14px;
    font-family: inherit;
    outline: none;
    transition: border-color 0.2s;
  }

  .form-group input:focus {
    border-color: var(--border-strong);
  }

  .btn-full {
    width: 100%;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 20px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    font-size: 14px;
    font-weight: 500;
    border: none;
    border-radius: 6px;
    cursor: pointer;
    transition: opacity 0.2s;
    font-family: inherit;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-primary:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .btn-outline {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 40px;
    padding: 0 20px;
    background: transparent;
    color: var(--text-primary);
    font-size: 14px;
    font-weight: 500;
    border: 1px solid var(--border-input);
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s;
    font-family: inherit;
    text-decoration: none;
  }

  .btn-outline:hover {
    background: var(--bg-hover);
  }

  .social-login {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .btn-social {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 42px;
    padding: 0 12px;
    font-size: 13px;
    font-weight: 500;
    font-family: inherit;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    border: 1px solid var(--border-input);
    background: var(--bg-card);
    color: var(--text-primary);
  }

  .btn-social:hover {
    background: var(--bg-hover);
  }

  .btn-social:hover {
    background: #f5f5f5;
  }

  .auth-divider {
    display: flex;
    align-items: center;
    gap: 16px;
    margin: 24px 0;
  }

  .auth-divider::before,
  .auth-divider::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .auth-divider span {
    font-size: 12px;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.5px;
    flex-shrink: 0;
  }

  .auth-error {
    font-size: 13px;
    color: #dc2626;
    margin: 0;
    text-align: center;
    display: none;
  }

  .auth-error.visible {
    display: block;
  }

  .auth-success {
    font-size: 13px;
    color: #16a34a;
    margin: 0;
    text-align: center;
    min-height: 20px;
  }

  .auth-footer {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }

  .auth-text-link {
    font-size: 13px;
    color: var(--text-tertiary);
    text-decoration: underline;
    transition: color 0.2s;
  }

  .auth-text-link:hover {
    color: var(--text-primary);
  }

  @media (max-width: 480px) {
    .auth-page {
      padding: 24px 16px;
    }
    .auth-card {
      padding: 28px 20px;
    }
    .auth-heading {
      font-size: 20px;
    }
  }

  @media (max-width: 360px) {
    .auth-page {
      padding: 16px 12px;
    }
    .auth-card {
      padding: 20px 16px;
      border-radius: 8px;
    }
    .auth-heading {
      font-size: 18px;
    }
  }
</style>
