---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <section class="result-section">
    <div class="band-inner result-card">
      <div class="result-icon">&#10003;</div>
      <h1 class="result-title">Payment successful!</h1>
      <p class="result-desc">Thank you for your purchase. Your access has been activated.</p>
      <div class="result-actions">
        <a href="/dashboard" class="btn-primary">Go to dashboard</a>
        <a href="/tools" class="btn-secondary">Browse tools</a>
      </div>
    </div>
  </section>
</Layout>

<style is:global>
  .result-section {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: calc(100vh - 64px - 200px);
    padding: 96px 24px;
  }

  .result-card {
    text-align: center;
    max-width: 480px;
  }

  .result-icon {
    font-size: 48px;
    line-height: 1;
    margin-bottom: 24px;
    color: #16a34a;
  }

  .result-title {
    font-size: 32px;
    font-weight: 600;
    line-height: 40px;
    letter-spacing: -1.28px;
    color: var(--text-primary);
    margin: 0 0 16px;
  }

  .result-desc {
    font-size: 16px;
    font-weight: 400;
    line-height: 24px;
    color: var(--text-secondary);
    margin: 0 0 32px;
  }

  .result-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--btn-primary-text);
    background: var(--btn-primary-bg);
    padding: 0 24px;
    height: 48px;
    border-radius: 100px;
    transition: opacity 0.2s;
    text-decoration: none;
    border: none;
  }

  .btn-primary:hover {
    opacity: 0.85;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 16px;
    font-weight: 500;
    line-height: 24px;
    color: var(--btn-secondary-text);
    background: var(--btn-secondary-bg);
    padding: 0 24px;
    height: 48px;
    border-radius: 100px;
    border: 1px solid var(--btn-secondary-border);
    transition: box-shadow 0.2s;
    text-decoration: none;
  }

  .btn-secondary:hover {
    box-shadow: 0px 1px 1px rgba(0,0,0,0.02), 0px 2px 2px rgba(0,0,0,0.04);
  }

  @media (max-width: 480px) {
    .result-section {
      padding: 64px 16px;
    }
    .result-title {
      font-size: 26px;
      line-height: 32px;
    }
    .result-actions {
      flex-direction: column;
      align-items: center;
    }
  }

  @media (max-width: 360px) {
    .result-section {
      padding: 48px 12px;
    }
    .result-title {
      font-size: 22px;
      line-height: 28px;
    }
    .result-desc {
      font-size: 14px;
      line-height: 22px;
    }
    .btn-primary,
    .btn-secondary {
      width: 100%;
      height: 44px !important;
      font-size: 14px !important;
    }
  }
</style>
