---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Cutting Length of Diamond Ties Calculator"
  description="Calculate the cutting length, number of ties, and total weight of diamond-shaped stirrups/ties for columns and beams."
  eyebrow="Cutting Length Tool"
>
  <div class="calculator-card">
    <p class="intro-note">
      Arrange your Beam/Column and stirrups as shown in the figure below and then input the value below.
    </p>

    <svg class="tie-figure" viewBox="0 0 280 260" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="10" y="10" width="260" height="220" rx="4" stroke="var(--border-strong)" stroke-width="1.5" stroke-dasharray="6 4" fill="none" />
      <text x="140" y="252" text-anchor="middle" font-size="12" fill="var(--text-tertiary)">Column / Beam Section</text>
      <polygon points="50,120 140,30 230,120 140,210" stroke="var(--text-primary)" stroke-width="2" fill="none" />
      <text x="96" y="98" text-anchor="end" font-size="13" fill="var(--text-primary)" font-weight="600">xy</text>
      <text x="185" y="98" text-anchor="start" font-size="13" fill="var(--text-primary)" font-weight="600">yz</text>
      <text x="185" y="148" text-anchor="start" font-size="13" fill="var(--text-primary)" font-weight="600">zw</text>
      <text x="96" y="148" text-anchor="end" font-size="13" fill="var(--text-primary)" font-weight="600">wx</text>
      <circle cx="50" cy="120" r="3" fill="var(--text-primary)" />
      <text x="36" y="116" text-anchor="end" font-size="11" fill="var(--text-secondary)">x</text>
      <circle cx="140" cy="30" r="3" fill="var(--text-primary)" />
      <text x="150" y="24" text-anchor="start" font-size="11" fill="var(--text-secondary)">y</text>
      <circle cx="230" cy="120" r="3" fill="var(--text-primary)" />
      <text x="244" y="116" text-anchor="start" font-size="11" fill="var(--text-secondary)">z</text>
      <circle cx="140" cy="210" r="3" fill="var(--text-primary)" />
      <text x="150" y="224" text-anchor="start" font-size="11" fill="var(--text-secondary)">w</text>
      <line x1="10" y1="120" x2="50" y2="120" stroke="var(--text-tertiary)" stroke-width="1" stroke-dasharray="3 2" />
      <line x1="230" y1="120" x2="270" y2="120" stroke="var(--text-tertiary)" stroke-width="1" stroke-dasharray="3 2" />
      <text x="270" y="125" text-anchor="end" font-size="10" fill="var(--text-tertiary)">AB</text>
      <line x1="140" y1="10" x2="140" y2="30" stroke="var(--text-tertiary)" stroke-width="1" stroke-dasharray="3 2" />
      <line x1="140" y1="210" x2="140" y2="230" stroke="var(--text-tertiary)" stroke-width="1" stroke-dasharray="3 2" />
      <text x="152" y="22" text-anchor="start" font-size="10" fill="var(--text-tertiary)">BC</text>
    </svg>

    <h2 class="section-title">A) Input Detail of Member &amp; Steel</h2>
    <div class="input-grid">
      <div class="input-group">
        <label>Column/Beam size AB &times; BC</label>
        <div class="double-input">
          <input type="number" id="sizeAB" value="450" step="any" min="1" />
          <span class="split-sep">&times;</span>
          <input type="number" id="sizeBC" value="400" step="any" min="1" />
          <span class="unit-tag">mm</span>
        </div>
      </div>
      <div class="input-group">
        <label>Diameter of ties/stirrups</label>
        <div class="input-with-unit">
          <input type="number" id="barDia" value="6" step="0.5" min="1" />
          <span class="unit-label">mm</span>
        </div>
      </div>
      <div class="input-group">
        <label>Clear cover</label>
        <div class="input-with-unit">
          <input type="number" id="clearCover" value="25" step="1" min="0" />
          <span class="unit-label">mm</span>
        </div>
      </div>
    </div>

    <h2 class="section-title">B) Stirrups run and spacing</h2>
    <div class="input-grid">
      <div class="input-group">
        <label>Length over which stirrups are provided</label>
        <div class="input-with-unit">
          <input type="number" id="runLength" value="10" step="any" min="0" />
          <select id="runLengthUnit"><option value="ft">feet</option><option value="mm">mm</option><option value="m">m</option></select>
        </div>
      </div>
      <div class="input-group">
        <label>Spacing between stirrups</label>
        <div class="input-with-unit">
          <input type="number" id="spacing" value="150" step="1" min="1" />
          <span class="unit-label">mm</span>
        </div>
      </div>
    </div>

    <div class="formula-note">
      <strong>Cutting length formula used,</strong> CL = 4 &times; (xy) + 6d,
      where xy = &radic;((AB &minus; 2&times;cover)&sup2; + (BC &minus; 2&times;cover)&sup2;) &divide; 2.
      Four sides are equal: xy = yz = zw = wx.
      No. of ties = (run length &divide; spacing) + 1. Unit weight = d&sup2; &divide; 162.25 kg/m.
    </div>

    <div class="btn-row">
      <button class="btn-primary" id="calcBtn">Re-Calculate</button>
      <button class="btn-secondary" id="resetBtn">Reset</button>
    </div>

    <div class="results-section" id="resultsSection" style="display: none;">
      <h2 class="section-title">Diamond Ties &ndash; Calculation</h2>

      <h3 class="table-heading">Inputs summary</h3>
      <div class="table-wrap">
      <table class="calc-table">
        <thead>
          <tr><th>Item</th><th>Value</th><th>Unit</th><th>Converted</th></tr>
        </thead>
        <tbody id="inputSummaryBody">
          <tr><td>Section size</td><td id="isSectionSize">450 &times; 400</td><td>mm</td><td>-</td></tr>
          <tr><td>Clear cover</td><td id="isCover">25</td><td>mm</td><td>-</td></tr>
          <tr><td>Bar diameter</td><td id="isBarDia">6</td><td>mm</td><td id="isUnitWt">Unit wt = 0.222 kg/m</td></tr>
          <tr><td>Run length</td><td id="isRunLength">10</td><td id="isRunLengthUnit">ft</td><td id="isRunLengthConverted">3048.0 mm</td></tr>
          <tr><td>Stirrups spacing</td><td id="isSpacing">150</td><td>mm</td><td>-</td></tr>
        </tbody>
      </table>
      </div>

      <h3 class="table-heading">Stirrups results</h3>
      <div class="table-wrap">
      <table class="calc-table">
        <thead>
          <tr><th>Item</th><th>Value</th><th>Unit</th><th>Notes</th></tr>
        </thead>
        <tbody id="resultsBody">
          <tr><td>Length of (xy = yz = zw = wx) of ties</td><td id="resSide">265.75364531836624</td><td>mm</td><td>&radic;(W&sup2;+H&sup2;) / 2</td></tr>
          <tr><td>Hook length provided</td><td id="resHook">54</td><td>mm</td><td>9d</td></tr>
          <tr><td>No. of 135&deg; bends</td><td>4</td><td>nos.</td><td>Deduction 12d (4 &times; 3d)</td></tr>
          <tr><td>Angle (xyz)&deg;</td><td id="resAngleXYZ">82.3718503314193</td><td>&deg;</td><td>Acute internal angle</td></tr>
          <tr><td>Angle (xwz)&deg;</td><td id="resAngleXWZ">97.62814966858069</td><td>&deg;</td><td>Obtuse internal angle</td></tr>
          <tr><td>Cutting length of ties/stirrups</td><td id="resCL">1099.014581273465</td><td>mm</td><td>CL = 4(xy) + 6d</td></tr>
          <tr><td>No. of ties required</td><td id="resTies">21.32</td><td>nos.</td><td>(run/spacing) + 1</td></tr>
          <tr><td>Total weight of steel required</td><td id="resWeight">5.198863922459228</td><td>kg</td><td>d&sup2;/162.25 &times; CL(m) &times; ties</td></tr>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  function toMm(val, unit) {
    if (unit === 'ft') return val * 304.8;
    if (unit === 'm') return val * 1000;
    return val;
  }

  function formatNum(v, d) {
    return Number(v).toFixed(d);
  }

  function deg(rad) {
    return rad * 180 / Math.PI;
  }

  function calculate() {
    const ab = parseFloat(document.getElementById('sizeAB').value) || 0;
    const bc = parseFloat(document.getElementById('sizeBC').value) || 0;
    const d = parseFloat(document.getElementById('barDia').value) || 0;
    const cover = parseFloat(document.getElementById('clearCover').value) || 0;
    const runRaw = parseFloat(document.getElementById('runLength').value) || 0;
    const runUnit = document.getElementById('runLengthUnit').value;
    const spacing = parseFloat(document.getElementById('spacing').value) || 1;

    const runMm = toMm(runRaw, runUnit);

    const W = ab - 2 * cover;
    const H = bc - 2 * cover;
    const side = Math.sqrt(W * W + H * H) / 2;
    const hook = 9 * d;
    const clPerStirrup = 4 * side + 6 * d;
    const numTies = (runMm / spacing) + 1;
    const unitWt = (d * d) / 162.25;
    const totalWt = (unitWt * clPerStirrup * numTies) / 1000;

    const cosAng = (W * W - H * H) / (W * W + H * H);
    const angRad = Math.acos(Math.max(-1, Math.min(1, cosAng)));
    const angDeg = deg(angRad);

    document.getElementById('isSectionSize').textContent = ab + ' \u00d7 ' + bc;
    document.getElementById('isCover').textContent = formatNum(cover, 0);
    document.getElementById('isBarDia').textContent = formatNum(d, 1);
    document.getElementById('isUnitWt').textContent = 'Unit wt = ' + formatNum(unitWt, 3) + ' kg/m';
    document.getElementById('isRunLength').textContent = formatNum(runRaw, 4);
    document.getElementById('isRunLengthUnit').textContent = runUnit;
    document.getElementById('isRunLengthConverted').textContent = formatNum(runMm, 1) + ' mm';
    document.getElementById('isSpacing').textContent = formatNum(spacing, 0);

    document.getElementById('resSide').textContent = String(side);
    document.getElementById('resHook').textContent = formatNum(hook, 0);
    document.getElementById('resCL').textContent = String(clPerStirrup);
    document.getElementById('resTies').textContent = formatNum(numTies, 2);
    document.getElementById('resWeight').textContent = String(totalWt);

    if (W >= H) {
      document.getElementById('resAngleXYZ').textContent = String(angDeg);
      document.getElementById('resAngleXWZ').textContent = String(180 - angDeg);
    } else {
      document.getElementById('resAngleXYZ').textContent = String(180 - angDeg);
      document.getElementById('resAngleXWZ').textContent = String(angDeg);
    }

    document.getElementById('resultsSection').style.display = 'block';
  }

  function resetForm() {
    const vals = {
      sizeAB: '450', sizeBC: '400',
      barDia: '6', clearCover: '25',
      runLength: '10', runLengthUnit: 'ft',
      spacing: '150'
    };
    for (const [id, val] of Object.entries(vals)) {
      const el = document.getElementById(id);
      if (el) el.value = val;
    }
    document.getElementById('resultsSection').style.display = 'none';
  }

  document.getElementById('calcBtn').addEventListener('click', calculate);
  document.getElementById('resetBtn').addEventListener('click', resetForm);
  document.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
  });

  calculate();
</script>

<style>
  .intro-note {
    font-size: 14px;
    line-height: 22px;
    color: var(--text-secondary);
    margin-bottom: 20px;
  }

  .tie-figure {
    display: block;
    width: 100%;
    max-width: 320px;
    margin: 0 auto 28px;
  }

  .section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .section-title:not(:first-child) {
    margin-top: 32px;
  }

  .input-with-unit {
    display: flex;
    gap: 8px;
  }

  .input-with-unit input {
    flex: 1;
    min-width: 0;
  }

  .input-with-unit select {
    width: 80px;
    flex-shrink: 0;
  }

  .unit-label {
    display: flex;
    align-items: center;
    font-size: 13px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .double-input {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .double-input input {
    flex: 1;
    min-width: 0;
    text-align: center;
  }

  .unit-tag {
    font-size: 13px;
    color: var(--text-tertiary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .split-sep {
    font-size: 14px;
    color: var(--text-secondary);
    flex-shrink: 0;
  }

  .formula-note {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-secondary);
    margin-top: 24px;
  }

  .btn-row {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .btn-primary {
    height: 44px;
    padding: 0 32px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--bg-hover); }

  .btn-secondary {
    height: 44px;
    padding: 0 32px;
    background: var(--btn-secondary-bg);
    color: var(--text-primary);
    border: 1px solid var(--border-input);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover { background: var(--bg-hover); }

  .table-heading {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 12px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .calc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-bottom: 8px;
  }

  .calc-table th,
  .calc-table td {
    padding: 10px 16px;
    border: 1px solid var(--result-border);
    text-align: left;
  }

  .calc-table th {
    background: var(--table-header-bg);
    font-weight: 600;
    color: var(--result-text-muted);
    font-size: 13px;
  }

  .calc-table td:last-child {
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .calc-table td:nth-child(2) {
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
</style>
