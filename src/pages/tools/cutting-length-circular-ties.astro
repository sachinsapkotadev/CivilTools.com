---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout
  title="Cutting Length of Circular Ties Calculator"
  description="Calculate the cutting length, number of ties, and total weight of circular stirrups/ties for columns. Uses CL = π(D − 2×cover) + 12d formula."
  eyebrow="Cutting Length Tool"
>
  <div class="calculator-card">
    <svg class="tie-figure" viewBox="0 0 280 260" fill="none" xmlns="http://www.w3.org/2000/svg">
      <rect x="10" y="10" width="260" height="200" rx="4" stroke="var(--border-strong)" stroke-width="1.5" stroke-dasharray="6 4" fill="none" />
      <text x="140" y="234" text-anchor="middle" font-size="12" fill="var(--text-tertiary)">Column Section</text>
      <circle cx="140" cy="110" r="80" stroke="var(--text-primary)" stroke-width="2" fill="none" />
      <text x="140" y="196" text-anchor="middle" font-size="12" fill="var(--text-primary)" font-weight="600">D (Column Dia)</text>
      <line x1="60" y1="110" x2="220" y2="110" stroke="var(--text-tertiary)" stroke-width="1" stroke-dasharray="4 3" />
      <text x="140" y="104" text-anchor="middle" font-size="10" fill="var(--text-tertiary)">D − 2×cover</text>
      <line x1="140" y1="30" x2="140" y2="190" stroke="var(--text-secondary)" stroke-width="1" stroke-miterlimit="10" marker-start="url(#arrowUp)" marker-end="url(#arrowDown)" />
      <defs>
        <marker id="arrowUp" markerWidth="6" markerHeight="6" refX="3" refY="6" orient="auto-start-reverse">
          <path d="M 0 6 L 3 0 L 6 6" fill="none" stroke="var(--text-secondary)" stroke-width="1" />
        </marker>
        <marker id="arrowDown" markerWidth="6" markerHeight="6" refX="3" refY="0" orient="auto">
          <path d="M 0 0 L 3 6 L 6 0" fill="none" stroke="var(--text-secondary)" stroke-width="1" />
        </marker>
      </defs>
    </svg>

    <h2 class="section-title">A) Input Detail of Member &amp; Steel</h2>
    <div class="input-grid">
      <div class="input-group">
        <label>a) Diameter of Column</label>
        <div class="input-with-unit">
          <input type="number" id="colDia" value="450" step="any" min="1" />
          <span class="unit-label">mm</span>
        </div>
      </div>
      <div class="input-group">
        <label>b) Diameter of ties/stirrups</label>
        <div class="input-with-unit">
          <input type="number" id="barDia" value="6" step="0.5" min="1" />
          <span class="unit-label">mm</span>
        </div>
      </div>
      <div class="input-group">
        <label>c) Clear Cover</label>
        <div class="input-with-unit">
          <input type="number" id="clearCover" value="25" step="1" min="0" />
          <span class="unit-label">mm</span>
        </div>
      </div>
    </div>

    <h2 class="section-title">B) Stirrups run and spacing</h2>
    <div class="input-grid">
      <div class="input-group">
        <label>d) Length up to stirrups provided (L)</label>
        <div class="input-with-unit">
          <input type="number" id="runLength" value="10" step="any" min="0" />
          <select id="runLengthUnit"><option value="ft">feet</option><option value="mm">mm</option><option value="m">m</option></select>
        </div>
      </div>
      <div class="input-group">
        <label>e) Spacing between stirrups</label>
        <div class="input-with-unit">
          <input type="number" id="spacing" value="150" step="1" min="1" />
          <span class="unit-label">mm</span>
        </div>
      </div>
    </div>

    <div class="formula-note">
      <strong>Cutting length formula used,</strong> CL = &pi;(D &minus; 2&times;cover) + 2&times;9d &minus; 2&times;3d = &pi;(D &minus; 2&times;cover) + 12d, where d = bar diameter. No. of ties = (run length &divide; spacing) + 1. Unit weight = d&sup2; &divide; 162.25 kg/m.
    </div>

    <div class="btn-row">
      <button class="btn-primary" id="calcBtn">Re-Calculate</button>
      <button class="btn-secondary" id="resetBtn">Reset</button>
    </div>

    <div class="results-section" id="resultsSection" style="display: none;">
      <h2 class="section-title">Circular Ties &ndash; Calculation</h2>

      <h3 class="table-heading">Inputs summary</h3>
      <div class="table-wrap">
      <table class="calc-table">
        <thead>
          <tr><th>Item</th><th>Value</th><th>Unit</th><th>Converted</th></tr>
        </thead>
        <tbody id="inputSummaryBody">
          <tr><td>Column diameter</td><td id="isColDia">450</td><td>mm</td><td>-</td></tr>
          <tr><td>Clear cover</td><td id="isCover">25</td><td>mm</td><td>-</td></tr>
          <tr><td>Bar diameter</td><td id="isBarDia">6</td><td>mm</td><td id="isUnitWt">Unit wt = 0.222 kg/m</td></tr>
          <tr><td>Run length</td><td id="isRunLength">10</td><td id="isRunLengthUnit">ft</td><td id="isRunLengthConverted">3048.0 mm</td></tr>
          <tr><td>Stirrups spacing</td><td id="isSpacing">150</td><td>mm</td><td>-</td></tr>
        </tbody>
      </table>
      </div>

      <h3 class="table-heading">Stirrups results</h3>
      <div class="table-wrap">
      <table class="calc-table">
        <thead>
          <tr><th>Item</th><th>Value</th><th>Unit</th><th>Notes</th></tr>
        </thead>
        <tbody id="resultsBody">
          <tr><td>Effective diameter (center line)</td><td id="resEffDia">400</td><td>mm</td><td>D &minus; 2&times;cover</td></tr>
          <tr><td>Hook length provided</td><td id="resHook">54</td><td>mm</td><td>9d per hook</td></tr>
          <tr><td>No. of 135&deg; bends</td><td>2</td><td>nos.</td><td>Deduction 6d (2 &times; 3d)</td></tr>
          <tr><td>Cutting length of ties/stirrups</td><td id="resCL">1328</td><td>mm</td><td>&pi;(D&minus;2c) + 12d</td></tr>
          <tr><td>No. of ties required</td><td id="resTies">21.32</td><td>nos.</td><td>(run/spacing) + 1</td></tr>
          <tr><td>Total weight of steel required</td><td id="resWeight">6.282</td><td>kg</td><td>d&sup2;/162.25 &times; CL(m) &times; ties</td></tr>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  function toMm(val, unit) {
    if (unit === 'ft') return val * 304.8;
    if (unit === 'm') return val * 1000;
    return val;
  }

  function formatNum(v, d) {
    return Number(v).toFixed(d);
  }

  function calculate() {
    const D = parseFloat(document.getElementById('colDia').value) || 0;
    const barDia = parseFloat(document.getElementById('barDia').value) || 0;
    const cover = parseFloat(document.getElementById('clearCover').value) || 0;
    const runRaw = parseFloat(document.getElementById('runLength').value) || 0;
    const runUnit = document.getElementById('runLengthUnit').value;
    const spacing = parseFloat(document.getElementById('spacing').value) || 1;

    const runMm = toMm(runRaw, runUnit);

    const effDia = D - 2 * cover;
    const hookPerHook = 9 * barDia;
    const hookTotal = 2 * hookPerHook;
    const bendDed = 2 * 3 * barDia;
    const clPerStirrup = Math.PI * effDia + hookTotal - bendDed;
    const numTies = (runMm / spacing) + 1;
    const unitWt = (barDia * barDia) / 162.25;
    const totalWt = (unitWt * clPerStirrup * numTies) / 1000;

    document.getElementById('isColDia').textContent = formatNum(D, 0);
    document.getElementById('isCover').textContent = formatNum(cover, 0);
    document.getElementById('isBarDia').textContent = formatNum(barDia, 1);
    document.getElementById('isUnitWt').textContent = 'Unit wt = ' + formatNum(unitWt, 3) + ' kg/m';
    document.getElementById('isRunLength').textContent = formatNum(runRaw, 4);
    document.getElementById('isRunLengthUnit').textContent = runUnit;
    document.getElementById('isRunLengthConverted').textContent = formatNum(runMm, 1) + ' mm';
    document.getElementById('isSpacing').textContent = formatNum(spacing, 0);

    document.getElementById('resEffDia').textContent = formatNum(effDia, 0);
    document.getElementById('resHook').textContent = formatNum(hookPerHook, 0);
    document.getElementById('resCL').textContent = formatNum(clPerStirrup, 0);
    document.getElementById('resTies').textContent = formatNum(numTies, 2);
    document.getElementById('resWeight').textContent = formatNum(totalWt, 3);

    document.getElementById('resultsSection').style.display = 'block';
  }

  function resetForm() {
    const vals = {
      colDia: '450', barDia: '6', clearCover: '25',
      runLength: '10', runLengthUnit: 'ft',
      spacing: '150'
    };
    for (const [id, val] of Object.entries(vals)) {
      const el = document.getElementById(id);
      if (el) el.value = val;
    }
    document.getElementById('resultsSection').style.display = 'none';
  }

  document.getElementById('calcBtn').addEventListener('click', calculate);
  document.getElementById('resetBtn').addEventListener('click', resetForm);
  document.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
  });

  calculate();
</script>

<style>
  .tie-figure {
    display: block;
    width: 100%;
    max-width: 320px;
    margin: 0 auto 28px;
  }

  .section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .section-title:not(:first-child) {
    margin-top: 32px;
  }

  .input-with-unit {
    display: flex;
    gap: 8px;
  }

  .input-with-unit input {
    flex: 1;
    min-width: 0;
  }

  .input-with-unit select {
    width: 80px;
    flex-shrink: 0;
  }

  .unit-label {
    display: flex;
    align-items: center;
    font-size: 13px;
    color: var(--text-secondary);
    white-space: nowrap;
  }

  .formula-note {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 16px;
    font-size: 13px;
    line-height: 20px;
    color: var(--text-secondary);
    margin-top: 24px;
  }

  .btn-row {
    display: flex;
    gap: 12px;
    margin-top: 24px;
  }

  .btn-primary {
    height: 44px;
    padding: 0 32px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--bg-hover); }

  .btn-secondary {
    height: 44px;
    padding: 0 32px;
    background: var(--btn-secondary-bg);
    color: var(--text-primary);
    border: 1px solid var(--border-input);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover { background: var(--bg-hover); }

  .table-heading {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 12px;
  }

  .table-wrap {
    overflow-x: auto;
  }

  .calc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-bottom: 8px;
  }

  .calc-table th,
  .calc-table td {
    padding: 10px 16px;
    border: 1px solid var(--result-border);
    text-align: left;
  }

  .calc-table th {
    background: var(--table-header-bg);
    font-weight: 600;
    color: var(--result-text-muted);
    font-size: 13px;
  }

  .calc-table td:last-child {
    color: var(--text-tertiary);
    font-size: 13px;
  }

  .calc-table td:nth-child(2) {
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
  }
</style>
