---
import ToolLayout from '../../layouts/ToolLayout.astro';
---

<ToolLayout 
  title="Carpet Estimator" 
  description="Calculate carpet area, material cost, and installation cost for any room. Supports multiple units and quantity."
  eyebrow="Estimation Tool"
>
  <div class="calculator-card">
    <h2 class="section-title">Room Dimensions</h2>
    <div class="input-grid">
      <div class="input-group">
        <label>Length</label>
        <div class="input-with-unit">
          <input type="number" id="roomLength" value="12" step="any" />
          <select id="lengthUnit">
            <option value="ft">Feet</option>
            <option value="m">meter</option>
            <option value="mm">mm</option>
            <option value="cm">cm</option>
            <option value="in">inch</option>
          </select>
        </div>
      </div>
      <div class="input-group">
        <label>Width</label>
        <div class="input-with-unit">
          <input type="number" id="roomWidth" value="11" step="any" />
          <select id="widthUnit">
            <option value="ft">Feet</option>
            <option value="m">meter</option>
            <option value="mm">mm</option>
            <option value="cm">cm</option>
            <option value="in">inch</option>
          </select>
        </div>
      </div>
      <div class="input-group">
        <label>Quantity</label>
        <div class="input-with-unit">
          <input type="number" id="roomQty" value="1" step="1" min="1" />
          <span class="unit-label">Nos.</span>
        </div>
      </div>
    </div>

    <h2 class="section-title">Cost Rates</h2>
    <div class="input-grid">
      <div class="input-group">
        <label>Cost of Carpet per sq ft</label>
        <div class="input-with-unit">
          <input type="number" id="carpetRate" value="300" step="1" min="0" />
          <span class="unit-label">Rs</span>
        </div>
      </div>
      <div class="input-group">
        <label>Installation Cost per sq ft</label>
        <div class="input-with-unit">
          <input type="number" id="installRate" value="300" step="1" min="0" />
          <span class="unit-label">Rs</span>
        </div>
      </div>
    </div>

    <div class="btn-row">
      <button class="btn-primary" id="calcBtn">Re-Calculate</button>
      <button class="btn-secondary" id="resetBtn">Reset</button>
    </div>

    <div class="results-section" id="resultsSection" style="display: none;">
      <h3 class="table-heading">Results</h3>
      <div class="table-wrap">
      <table class="calc-table">
        <thead>
          <tr><th>Item</th><th>Quantity</th><th>Cost</th></tr>
        </thead>
        <tbody>
          <tr><td>Total Area of Carpet</td><td id="resArea">–</td><td>–</td></tr>
          <tr><td>Carpet Material Cost</td><td id="resCarpetCost">–</td><td id="resCarpetCostVal">–</td></tr>
          <tr><td>Installation Cost</td><td id="resInstallCost">–</td><td id="resInstallCostVal">–</td></tr>
          <tr class="total-row"><td>Total Cost</td><td>–</td><td id="resTotalCost">–</td></tr>
        </tbody>
      </table>
      </div>
    </div>
  </div>
</ToolLayout>

<script>
  function toFeet(val, unit) {
    if (unit === 'm') return val * 3.28084;
    if (unit === 'mm') return val / 304.8;
    if (unit === 'cm') return val / 30.48;
    if (unit === 'in') return val / 12;
    return val; // ft
  }

  function fmt(v, d) {
    return Number(v.toFixed(d)).toLocaleString('en-IN');
  }

  function fmtCost(v) {
    if (v <= 0) return '–';
    return 'Rs ' + Number(v.toFixed(2)).toLocaleString('en-IN');
  }

  function calculate() {
    const L = toFeet(
      parseFloat(document.getElementById('roomLength').value) || 0,
      document.getElementById('lengthUnit').value
    );
    const W = toFeet(
      parseFloat(document.getElementById('roomWidth').value) || 0,
      document.getElementById('widthUnit').value
    );
    const qty = parseInt(document.getElementById('roomQty').value) || 1;
    const carpetRate = parseFloat(document.getElementById('carpetRate').value) || 0;
    const installRate = parseFloat(document.getElementById('installRate').value) || 0;

    const areaSqFt = L * W * qty;
    const carpetCost = areaSqFt * carpetRate;
    const installCost = areaSqFt * installRate;
    const totalCost = carpetCost + installCost;

    document.getElementById('resArea').textContent = fmt(areaSqFt, 3) + ' sq ft';
    document.getElementById('resCarpetCost').textContent = fmt(areaSqFt, 3) + ' sq ft';
    document.getElementById('resCarpetCostVal').textContent = fmtCost(carpetCost);
    document.getElementById('resInstallCost').textContent = fmt(areaSqFt, 3) + ' sq ft';
    document.getElementById('resInstallCostVal').textContent = fmtCost(installCost);
    document.getElementById('resTotalCost').textContent = fmtCost(totalCost);

    document.getElementById('resultsSection').style.display = 'block';
  }

  function resetForm() {
    const defaults = {
      roomLength: '12', lengthUnit: 'ft',
      roomWidth: '11', widthUnit: 'ft',
      roomQty: '1',
      carpetRate: '300', installRate: '300'
    };
    for (const [id, val] of Object.entries(defaults)) {
      const el = document.getElementById(id);
      if (el) el.value = val;
    }
    document.getElementById('resultsSection').style.display = 'none';
  }

  document.getElementById('calcBtn').addEventListener('click', calculate);
  document.getElementById('resetBtn').addEventListener('click', resetForm);
  document.querySelectorAll('input, select').forEach(el => {
    el.addEventListener('keydown', e => { if (e.key === 'Enter') calculate(); });
  });

  calculate();
</script>

<style>
  .section-title {
    font-size: 16px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .section-title:not(:first-child) {
    margin-top: 32px;
  }

  .input-with-unit {
    display: flex;
    gap: 8px;
  }

  .input-with-unit input {
    flex: 1;
    min-width: 0;
  }

  .input-with-unit select {
    width: 100px;
    flex-shrink: 0;
  }

  .unit-label {
    display: flex;
    align-items: center;
    height: 44px;
    padding: 0 14px;
    background: var(--bg-hover);
    border: 1px solid var(--border-input);
    border-radius: 8px;
    font-size: 14px;
    color: var(--text-secondary);
    white-space: nowrap;
    flex-shrink: 0;
  }

  .btn-row {
    display: flex;
    gap: 12px;
    margin-top: 32px;
  }

  .btn-primary {
    height: 44px;
    padding: 0 32px;
    background: var(--btn-primary-bg);
    color: var(--btn-primary-text);
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s;
  }

  .btn-primary:hover { background: var(--bg-hover); }

  .btn-secondary {
    height: 44px;
    padding: 0 32px;
    background: var(--btn-secondary-bg);
    color: var(--text-primary);
    border: 1px solid var(--border-input);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.2s;
  }

  .btn-secondary:hover { background: var(--bg-hover); }

  .table-heading {
    font-size: 15px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 24px 0 12px;
  }

  .calc-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 14px;
    margin-bottom: 8px;
  }

  .calc-table th,
  .calc-table td {
    padding: 10px 16px;
    border: 1px solid var(--result-border);
    text-align: left;
  }

  .calc-table th {
    background: var(--table-header-bg);
    font-weight: 600;
    color: var(--result-text-muted);
    font-size: 13px;
  }

  .calc-table td:nth-child(2),
  .calc-table td:nth-child(3) {
    font-weight: 600;
    color: var(--text-primary);
    font-variant-numeric: tabular-nums;
    text-align: right;
  }

  .calc-table td:nth-child(3) {
    color: var(--color-success);
  }

  .total-row td {
    border-top: 2px solid var(--border-strong);
    font-weight: 700;
    color: var(--text-primary);
  }

  .total-row td:last-child {
    font-size: 16px;
    color: var(--color-success);
  }
</style>
